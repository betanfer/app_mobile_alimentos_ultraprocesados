<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de alimento con el mismo estilo que la demo original de JuegoActivity:
     imagen 125dp + etiqueta oscura montada 50% sobre la imagen y 50% abajo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/imgFood"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:contentDescription="@string/img_plate_description"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Borde verde cuando el alimento está en la bandeja -->
    <View
        android:id="@+id/viewSelected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_food_selected"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/imgFood"
        app:layout_constraintEnd_toEndOf="@+id/imgFood"
        app:layout_constraintStart_toStartOf="@+id/imgFood"
        app:layout_constraintTop_toTopOf="@+id/imgFood" />

    <TextView
        android:id="@+id/tvCheck"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="6dp"
        android:background="@drawable/dot_shape"
        android:backgroundTint="@color/color_success"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/color_button_primary_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/imgFood"
        app:layout_constraintTop_toTopOf="@+id/imgFood" />

    <TextView
        android:id="@+id/tvFood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_dark"
        android:fontFamily="@font/open_dyslexic"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:textColor="@color/color_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imgFood"
        app:layout_constraintEnd_toEndOf="@+id/imgFood"
        app:layout_constraintStart_toStartOf="@+id/imgFood"
        app:layout_constraintTop_toBottomOf="@+id/imgFood" />

</androidx.constraintlayout.widget.ConstraintLayout>
