<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="@dimen/spacing_medium">

    <!-- Botón de Volver (<) -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/btn_back_description"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Encabezado: Puntuación y Tiempo -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_tag"
        android:fontFamily="@font/open_dyslexic"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Puntos: 0"
        android:textColor="@color/color_success"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_tag"
        android:fontFamily="@font/open_dyslexic"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Tiempo: 30s"
        android:textColor="@color/color_warning"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        tools:ignore="HardcodedText" />

    <!-- Zona central de interacción -->
    <ImageView
        android:id="@+id/imgPlate"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:contentDescription="Plato de comida"
        android:src="@drawable/dot_shape"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_text_secondary"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvGameInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_dyslexic"
        android:text="¡Atrapa la comida saludable!"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_size_button"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imgPlate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvScore"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_green"
        android:fontFamily="@font/open_dyslexic"
        android:text="¡JUGAR!"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>