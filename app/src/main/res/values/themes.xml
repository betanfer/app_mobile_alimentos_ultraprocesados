<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================= -->
    <!--  TEMA PRINCIPAL (Visión Normal)                -->
    <!-- ============================================= -->

    <style name="Theme.CodigoVerde" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores primarios del Material Theme -->
        <item name="colorPrimary">@color/color_success</item>
        <item name="colorPrimaryVariant">@color/color_text_secondary</item>
        <item name="colorOnPrimary">@color/color_background</item>

        <item name="colorSecondary">@color/color_button_secondary</item>
        <item name="colorSecondaryVariant">@color/color_text_secondary</item>
        <item name="colorOnSecondary">@color/color_background</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_text_primary</item>

        <!-- Fondo y superficies -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_background</item>
        <item name="colorOnSurface">@color/color_text_primary</item>

        <!-- Tipografía global: OpenDyslexic -->
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="fontFamily">@font/open_dyslexic</item>

        <!-- Colores de texto globales -->
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>

        <!-- Estilo de botón por defecto -->
        <item name="materialButtonStyle">@style/Widget.CodigoVerde.Button.Primary</item>
    </style>


    <!-- ============================================= -->
    <!--  TEMA PROTANOPIA / DEUTERANOPIA                -->
    <!-- ============================================= -->

    <style name="Theme.CodigoVerde.Protanopia" parent="Theme.CodigoVerde">
        <item name="colorPrimary">@color/color_protan_success</item>
        <item name="colorPrimaryVariant">@color/color_protan_text_secondary</item>
        <item name="colorOnPrimary">@color/color_protan_background</item>

        <item name="colorSecondary">@color/color_protan_text_secondary</item>
        <item name="colorOnSecondary">@color/color_protan_background</item>

        <item name="colorError">@color/color_protan_error</item>
        <item name="colorOnError">@color/color_protan_text_primary</item>

        <item name="android:colorBackground">@color/color_protan_background</item>
        <item name="colorSurface">@color/color_protan_background</item>
        <item name="colorOnSurface">@color/color_protan_text_primary</item>

        <item name="android:textColor">@color/color_protan_text_primary</item>
        <item name="android:textColorPrimary">@color/color_protan_text_primary</item>
        <item name="android:textColorSecondary">@color/color_protan_text_secondary</item>
        <item name="android:textColorHint">@color/color_protan_text_secondary</item>
    </style>


    <!-- ============================================= -->
    <!--  TEMA TRITANOPIA                               -->
    <!-- ============================================= -->

    <style name="Theme.CodigoVerde.Tritanopia" parent="Theme.CodigoVerde">
        <item name="colorPrimary">@color/color_tritan_success</item>
        <item name="colorPrimaryVariant">@color/color_tritan_text_secondary</item>
        <item name="colorOnPrimary">@color/color_tritan_background</item>

        <item name="colorSecondary">@color/color_tritan_text_secondary</item>
        <item name="colorOnSecondary">@color/color_tritan_background</item>

        <item name="colorError">@color/color_tritan_error</item>
        <item name="colorOnError">@color/color_tritan_text_primary</item>

        <item name="android:colorBackground">@color/color_tritan_background</item>
        <item name="colorSurface">@color/color_tritan_background</item>
        <item name="colorOnSurface">@color/color_tritan_text_primary</item>

        <item name="android:textColor">@color/color_tritan_text_primary</item>
        <item name="android:textColorPrimary">@color/color_tritan_text_primary</item>
        <item name="android:textColorSecondary">@color/color_tritan_text_secondary</item>
        <item name="android:textColorHint">@color/color_tritan_text_secondary</item>
    </style>


    <!-- ============================================= -->
    <!--  ESTILOS DE TEXTO                              -->
    <!-- ============================================= -->

    <style name="TextAppearance.CodigoVerde.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.CodigoVerde.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.CodigoVerde.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.CodigoVerde.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="fontFamily">@font/open_dyslexic</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <!-- ============================================= -->
    <!--  BOTÓN PRIMARIO                                -->
    <!--  Verde success, ancho completo, esquinas       -->
    <!--  redondeadas, con márgenes laterales.          -->
    <!-- ============================================= -->

    <style name="Widget.CodigoVerde.Button.Primary" parent="Widget.MaterialComponents.Button">
        <!-- Color de fondo y texto -->
        <item name="backgroundTint">@color/color_button_primary</item>
        <item name="android:textColor">@color/color_button_primary_text</item>

        <!-- Esquinas redondeadas -->
        <item name="cornerRadius">@dimen/button_corner_radius</item>

        <!-- Eliminar insets verticales para dar más espacio a la fuente OpenDyslexic -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">60dp</item>

        <!-- Tamaño y espaciado -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">@dimen/button_primary_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_primary_padding_horizontal</item>

        <!-- Tipografía: Forzar OpenDyslexic en MaterialButton -->
        <item name="android:fontFamily">@font/open_dyslexic</item>
        <item name="fontFamily">@font/open_dyslexic</item>
        <item name="android:textAppearance">@style/TextAppearance.CodigoVerde.Button</item>
        <item name="android:textAllCaps">false</item>

        <!-- Elevación sutil -->
        <item name="elevation">2dp</item>
    </style>


    <!-- ============================================= -->
    <!--  BOTÓN SECUNDARIO                              -->
    <!--  Turquesa, pequeño ~1:1, bordes redondeados.   -->
    <!--  Pensado para esquina superior derecha          -->
    <!--  (menú, opciones, configuración).               -->
    <!-- ============================================= -->

    <style name="Widget.CodigoVerde.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <!-- Color de fondo y texto -->
        <item name="backgroundTint">@color/color_button_secondary</item>
        <item name="android:textColor">@color/color_button_secondary_text</item>

        <!-- Tamaño cuadrado -->
        <item name="android:minWidth">@dimen/button_secondary_size</item>
        <item name="android:minHeight">@dimen/button_secondary_size</item>
        <item name="android:maxWidth">56dp</item>

        <!-- Esquinas redondeadas -->
        <item name="cornerRadius">@dimen/button_secondary_corner_radius</item>

        <!-- Padding interno reducido para mantener compacto -->
        <item name="android:padding">@dimen/spacing_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <!-- Tipografía -->
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/open_dyslexic</item>

        <item name="elevation">2dp</item>
    </style>


    <!-- ============================================= -->
    <!--  BOTÓN ICONO SECUNDARIO (para usar con         -->
    <!--  MaterialButton + iconGravity="textStart")     -->
    <!-- ============================================= -->

    <style name="Widget.CodigoVerde.Button.Icon" parent="Widget.MaterialComponents.Button.Icon">
        <item name="backgroundTint">@color/color_button_secondary</item>
        <item name="iconTint">@color/color_button_secondary_text</item>
        <item name="cornerRadius">@dimen/button_secondary_corner_radius</item>
        <item name="android:minWidth">@dimen/button_secondary_size</item>
        <item name="android:minHeight">@dimen/button_secondary_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">@dimen/spacing_small</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

</resources>
